# Vhost de tdg-marketing. provision.sh sustituye __DOMAIN__ y __APP_DIR__.
# HTTP/2 + assets inmutables + FastCGI afinado. HTML/Livewire NUNCA se cachean.

limit_req_zone $binary_remote_addr zone=tdg_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=tdg_public:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=tdg_conn:10m;

upstream tdg_php {
    server unix:/run/php/php8.4-fpm-tdg.sock;
    keepalive 32;
}

server {
    listen 80;
    server_name __DOMAIN__;

    root __APP_DIR__/public;
    index index.php;

    charset utf-8;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-XSS-Protection "0" always;

    limit_conn tdg_conn 40;

    location ^~ /build/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ^~ /fonts/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ^~ /js/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ^~ /css/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ^~ /images/ {
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location = /favicon.ico {
        access_log off;
        expires 30d;
        log_not_found off;
    }

    location = /robots.txt {
        access_log off;
        log_not_found off;
    }

    location = /up {
        access_log off;
        try_files $uri /index.php?$query_string;
    }

    location ^~ /marketing/login {
        limit_req zone=tdg_login burst=10 nodelay;
        try_files $uri /index.php?$query_string;
    }

    location ^~ /inscripcion {
        limit_req zone=tdg_public burst=20 nodelay;
        try_files $uri /index.php?$query_string;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass tdg_php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS $https if_not_empty;
        fastcgi_hide_header X-Powered-By;

        fastcgi_keep_conn on;
        fastcgi_buffering on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_busy_buffers_size 64k;
        fastcgi_connect_timeout 5s;
        fastcgi_send_timeout 60s;
        fastcgi_read_timeout 60s;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
