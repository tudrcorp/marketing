# Copiar a /var/www/tdg-marketing/.env y rellenar los secretos.
# Nunca commitees el .env real.

APP_NAME="TDG Marketing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://DOMINIO_AQUI

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------------
# Base de datos de ESTA app (no la del API).
# Preferible: el servidor MySQL ya existente, base `tdg_marketing`.
# SQLite está prohibido en este servidor (HDD + alta concurrencia = locks).
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=IP_PRIVADA_SERVIDOR_BD
DB_PORT=3306
DB_DATABASE=tdg_marketing
DB_USERNAME=tdg_marketing
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Redis local — cache, sesiones, colas y locks. Todo en RAM (el disco es HDD).
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PERSISTENT=true
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

CACHE_STORE=redis
CACHE_PREFIX=tdg-marketing-cache-

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# retry_after DEBE superar el timeout más largo (ProcessMassNotification=900s,
# jobs de correo = email_timeout+60). Si es menor, la cola reentrega el job
# mientras sigue corriendo y duplica correos.
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=960

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Marketing API (integracorp-api). Usa la IP privada si ambos servidores
# están en la misma red; no expongas el API a Internet solo por esto.
# MARKETING_API_KEY debe coincidir con INTEGRACORP_API_KEY del API.
# ---------------------------------------------------------------------------
MARKETING_API_URL=http://IP_PRIVADA_API:4000
MARKETING_API_KEY=
MARKETING_API_TIMEOUT=15
MARKETING_API_BATCH_TIMEOUT=30
MARKETING_API_EMAIL_TIMEOUT=300
MARKETING_API_BULK_EMAILS_PATH=/api/emails/bulk
MARKETING_API_MASS_SEND_BATCH_PATH=/api/notifications/mass/send-batch
MARKETING_API_BIRTHDAY_TEST_SEND_PATH=/api/notifications/birthday/test
MARKETING_BIRTHDAY_EMAIL_BATCH_SIZE=50
MARKETING_WHATSAPP_BATCH_SIZE=50
MARKETING_WHATSAPP_BATCH_PAUSE_SECONDS=15
MARKETING_MASS_EMAIL_BATCH_SIZE=15
MARKETING_MASS_EMAIL_BATCH_PAUSE_SECONDS=30
MARKETING_MASS_EMAIL_QUOTA_COOLDOWN_MINUTES=60
MARKETING_MASS_EMAIL_AUTH_COOLDOWN_MINUTES=15

MAIL_MAILER=log
MAIL_FROM_ADDRESS="marketing@DOMINIO_AQUI"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
